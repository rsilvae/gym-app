// Schema de Prisma: aquí se definen las tablas de la base de datos.
// Después de cambiarlo, corre `npm run db:migrate` para crear una migración
// (un archivo SQL con los cambios) y aplicarla a la base.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Un usuario de la app. Nunca guardamos la contraseña: solo su hash (bcrypt).
model User {
  id              String      @id @default(cuid())
  email           String      @unique
  /// Nombre de usuario, siempre en minúsculas (así "Ana" y "ana" son el mismo).
  username        String      @unique
  passwordHash    String
  /// Cuándo confirmó su email con el código. null = todavía no puede entrar.
  emailVerifiedAt DateTime?
  /// Va dentro de cada token. Subirlo invalida todas las sesiones abiertas.
  tokenVersion    Int         @default(0)
  createdAt       DateTime    @default(now())
  routines        Routine[]
  workouts        Workout[]
  emailCodes      EmailCode[]
}

/// Para qué sirve un código enviado por email.
enum EmailCodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Código de 6 dígitos enviado por email. Se guarda solo su hash, como una contraseña.
model EmailCode {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailCodePurpose
  codeHash  String
  expiresAt DateTime
  /// Intentos fallidos: al llegar al máximo, el código deja de servir.
  attempts  Int              @default(0)
  /// Cuándo se envió (para no reenviar más de uno por minuto).
  createdAt DateTime         @default(now())

  /// Un solo código activo por usuario y propósito: uno nuevo reemplaza al anterior.
  @@unique([userId, purpose])
}

/// Una rutina de entrenamiento (ej: "Pecho y tríceps"). Pertenece a un usuario.
model Routine {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  exercises RoutineExercise[]
  workouts  Workout[]

  @@index([userId])
}

/// Un ejercicio dentro de una rutina, con su objetivo.
model RoutineExercise {
  id           String  @id @default(cuid())
  routineId    String
  // onDelete: Cascade → si borras la rutina, se borran sus ejercicios.
  routine      Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  name         String
  order        Int // posición en la rutina (0, 1, 2...)
  targetSets   Int
  targetReps   Int
  targetWeight Float   @default(0) // kg; 0 = peso corporal

  @@index([routineId])
}

/// Un entrenamiento terminado (una sesión en el gimnasio).
model Workout {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // onDelete: SetNull → si borras la rutina, el historial se conserva (sin el enlace).
  routineId   String?
  routine     Routine?     @relation(fields: [routineId], references: [id], onDelete: SetNull)
  // Copia del nombre: así el historial se lee bien aunque la rutina cambie o se borre.
  routineName String
  startedAt   DateTime
  finishedAt  DateTime
  createdAt   DateTime     @default(now())
  sets        WorkoutSet[]

  @@index([userId, finishedAt])
}

/// Una serie hecha en un entrenamiento: qué ejercicio, cuánto peso y cuántas reps.
model WorkoutSet {
  id            String  @id @default(cuid())
  workoutId     String
  workout       Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseName  String
  exerciseOrder Int // posición del ejercicio en el entrenamiento (0, 1, 2...)
  setNumber     Int // número de serie dentro del ejercicio (1, 2, 3...)
  weight        Float // kg
  reps          Int

  @@index([workoutId])
  @@index([exerciseName])
}
