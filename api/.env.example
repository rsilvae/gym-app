# Copia este archivo como .env y completa los valores.
# El .env NUNCA se sube a GitHub (está en .gitignore).

# Connection string de PostgreSQL (Neon: Dashboard → Connect → copia la URL)
DATABASE_URL="postgresql://usuario:password@host/base?sslmode=verify-full"

# Puerto del servidor
PORT=3000

# Clave para firmar los tokens de login (mínimo 32 caracteres, aleatoria).
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"

# Duración de la sesión
JWT_EXPIRES_IN="7d"
